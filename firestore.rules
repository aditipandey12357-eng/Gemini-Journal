rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny rule for unmapped collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Strictly isolate all user data and subcollections (journals, messages, evolutions)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
